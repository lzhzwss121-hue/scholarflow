# Optional frontend overrides. The built-in defaults already target
# http://127.0.0.1:8000 with 30-second normal and 90-second research timeouts.
# Copy this file to apps/web/.env.local only when you need custom values.

VITE_SCHOLARFLOW_API_BASE_URL=http://127.0.0.1:8000
VITE_SCHOLARFLOW_API_TIMEOUT_MS=30000
VITE_SCHOLARFLOW_RESEARCH_TIMEOUT_MS=90000
