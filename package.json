{
  "name": "scholarflow",
  "version": "0.1.0",
  "private": true,
  "description": "Chinese-first AI research workflow agent.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @scholarflow/web run dev",
    "dev:api": "python3 -m uvicorn scholarflow_api.main:app --app-dir services/api/src --host 127.0.0.1 --port 8000",
    "dev:api:reload": "python3 -m uvicorn scholarflow_api.main:app --reload --app-dir services/api/src",
    "dev:worker": "PYTHONPATH=services/api/src .venv/bin/python -m scholarflow_api.jobs.worker",
    "dev:cli": "npm --workspace @scholarflow/cli run dev",
    "db:init": "PYTHONPATH=services/api/src python3 -m scholarflow_api.database",
    "build": "npm --workspaces --if-present run build",
    "check": "npm --workspaces --if-present run check",
    "generate:api-types": "PYTHONPATH=services/api/src .venv/bin/python -m scholarflow_api.openapi_types",
    "test:e2e": "npm --workspace @scholarflow/web run test:e2e",
    "test:cli": "npm --workspace @scholarflow/cli run test",
    "eval:rag": "PYTHONPATH=services/api/src .venv/bin/python -m scholarflow_api.rag_benchmark",
    "eval:rag:real-predict": "PYTHONPATH=services/api/src .venv/bin/python -m scholarflow_api.real_paper_prediction_runner",
    "eval:rag:dataset": "PYTHONPATH=services/api/src .venv/bin/python -m scholarflow_api.real_paper_dataset",
    "eval:rag:live": "PYTHONPATH=services/api/src .venv/bin/python -m scholarflow_api.rag_live_smoke",
    "health:api": "PYTHONPATH=services/api/src python3 -m scholarflow_api.healthcheck",
    "version:cli": "npm --workspace @scholarflow/cli run start -- --version"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  }
}
