{
  "name": "scholarflow",
  "version": "0.1.0",
  "private": true,
  "description": "Chinese-first AI research workflow agent.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @scholarflow/web run dev",
    "dev:api": "python3 -m uvicorn scholarflow_api.main:app --app-dir services/api/src --host 127.0.0.1 --port 8000",
    "dev:api:reload": "python3 -m uvicorn scholarflow_api.main:app --reload --app-dir services/api/src",
    "dev:cli": "npm --workspace @scholarflow/cli run dev",
    "db:init": "PYTHONPATH=services/api/src python3 -m scholarflow_api.database",
    "build": "npm --workspaces --if-present run build",
    "check": "npm --workspaces --if-present run check",
    "health:api": "PYTHONPATH=services/api/src python3 -m scholarflow_api.healthcheck",
    "version:cli": "npm --workspace @scholarflow/cli run start -- --version"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
