# ScholarFlow backend environment example
# Copy this file to .env in the repository root.
# Never commit real API keys.

# The Web UI explicitly requests the OpenRouter provider. With an empty key,
# the backend immediately uses its deterministic local fallback.
SCHOLARFLOW_MODEL_PROVIDER=openrouter

# OpenRouter Research Plan (optional)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m2.5
OPENROUTER_APP_URL=https://github.com/lzhzwss121-hue/scholarflow
OPENROUTER_APP_TITLE=ScholarFlow
# Keep this below the Web client's 30-second normal request timeout.
OPENROUTER_TIMEOUT_SECONDS=25

# OpenAlex: anonymous requests have only a very small daily trial budget.
# A free API key is strongly recommended for normal searches.
OPENALEX_API_KEY=

# Literature request and SQLite cache limits
SCHOLARFLOW_REQUEST_TIMEOUT_SECONDS=12
SCHOLARFLOW_REQUEST_CACHE_TTL_SECONDS=900
SCHOLARFLOW_RETRIEVAL_CACHE_TTL_SECONDS=86400

# Open-access PDF and local PDF parsing
SCHOLARFLOW_AUTO_FETCH_PDF=1
SCHOLARFLOW_PDF_TIMEOUT_SECONDS=6
SCHOLARFLOW_PDF_FETCH_WORKERS=5
SCHOLARFLOW_PDF_MAX_BYTES=20971520
SCHOLARFLOW_PDF_MAX_PAGES=80
SCHOLARFLOW_PDF_MAX_TEXT_CHARS=50000
SCHOLARFLOW_PDF_MIN_TEXT_CHARS=1200

# Manual-mode SQLite. CLI start overrides this with its workspace database.
SCHOLARFLOW_DB_PATH=services/api/.data/scholarflow.sqlite3
