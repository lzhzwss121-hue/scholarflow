# ScholarFlow environment example
# Copy this file to .env or configure these variables in your shell.
# Never commit real API keys.

# Preferred model provider
SCHOLARFLOW_MODEL_PROVIDER=openrouter

# OpenRouter model routing
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m2.5
OPENROUTER_FAST_MODEL=minimax/minimax-m2.5
OPENROUTER_RAG_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_APP_URL=https://github.com/lzhzwss121-hue/scholarflow
OPENROUTER_APP_TITLE=ScholarFlow

# Optional DeepSeek fallback
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FAST_MODEL=deepseek-v4-flash

# Optional literature APIs
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
OPENALEX_EMAIL=
CROSSREF_MAILTO=

# Local workspace
SCHOLARFLOW_WORKSPACE=~/.scholarflow
SCHOLARFLOW_DB_PATH=services/api/.data/scholarflow.sqlite3
SCHOLARFLOW_LOG_LEVEL=info

# Development
SCHOLARFLOW_ENV=development
VITE_SCHOLARFLOW_API_BASE_URL=http://127.0.0.1:8000
VITE_SCHOLARFLOW_API_TIMEOUT_MS=30000
WEB_PORT=5173
API_PORT=8000
